---
// diffle "hunk" mark — a code tile with the line under review highlighted. themes via
// currentColor (frame + context lines) + var(--accent) (the reviewed band). `animated`
// plays a one-shot entrance: the context lines draw in, then the band sweeps across.
interface Props {
  size?: number;
  class?: string;
  animated?: boolean;
}
const { size = 28, class: klass = "", animated = false } = Astro.props;
---

<svg
  class:list={["mark", klass, { animated }]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
>
  <rect x="4" y="4" width="24" height="24" rx="6.5" stroke="currentColor" stroke-width="2"></rect>
  <rect class="line" x="8.5" y="9" width="11" height="2.75" rx="1.375" fill="currentColor" fill-opacity="0.55"></rect>
  <rect class="band" x="7" y="13.75" width="18" height="4.5" rx="2.25" fill="var(--accent)"></rect>
  <rect class="line late" x="8.5" y="20.25" width="7.5" height="2.75" rx="1.375" fill="currentColor" fill-opacity="0.55"></rect>
</svg>

<style>
  .animated rect {
    transform-box: fill-box;
    transform-origin: 0% 50%;
  }
  .animated .line {
    animation: draw 0.5s cubic-bezier(0.2, 0.9, 0.25, 1) 0.15s both;
  }
  .animated .late {
    animation-delay: 0.25s;
  }
  .animated .band {
    animation: draw 0.6s cubic-bezier(0.2, 0.9, 0.25, 1) 0.45s both;
  }
  @keyframes draw {
    from { transform: scaleX(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .animated rect {
      animation: none;
    }
  }
</style>
