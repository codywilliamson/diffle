---
// diffle mark — a split aperture that reads as a before/after diff: a lens ring
// cut down the middle, the trailing half filled with the indigo accent. themes via
// currentColor (ring/text) + var(--accent) (fill).
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: klass = "" } = Astro.props;
---

<svg
  class={klass}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  role="img"
>
  <rect x="3.25" y="3.25" width="25.5" height="25.5" rx="7.5" stroke="currentColor" stroke-width="1.5" opacity="0.85"></rect>
  <path d="M16 4.5 V27.5" stroke="currentColor" stroke-width="1.5" opacity="0.55"></path>
  <path d="M18.5 8.5 H24 a3.5 3.5 0 0 1 3.5 3.5 V20 a3.5 3.5 0 0 1 -3.5 3.5 H18.5 Z" fill="var(--accent)"></path>
  <circle cx="11" cy="16" r="2.4" fill="currentColor" opacity="0.8"></circle>
</svg>
