---
import Landing from "../layouts/Landing.astro";

const repo = "https://github.com/codywilliamson/diffle";
const installUnix = "curl -fsSL https://diffle.dev/install | sh";
const installWin = "irm https://diffle.dev/install.ps1 | iex";

const loop = [
  ["inspect", "Render a live git comparison in the browser."],
  ["comment", "Anchor notes to a line, a range, or a file."],
  ["return", "Compile the redline into agent-ready feedback."],
  ["refresh", "Re-run the diff after the agent edits."],
  ["resolve", "Reply, reopen, and clear threads."],
  ["approve", "Sign off on a durable Review Record."],
];

const cli = [
  ["diffle", "working tree vs HEAD"],
  ["diffle staged", "staged changes only"],
  ["diffle main", "this branch vs main"],
  ["diffle v1.0..v1.1", "a commit range"],
  ["diffle browse src/", "the whole subtree"],
];
---

<Landing>
  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="hero-grid wrap">
      <div class="hero-copy">
        <h1>
          Review the diff. <br />Redline it. <br /><span class="accent-ink"
            >Hand it back to your agent.</span
          >
        </h1>
        <p class="lede">
          diffle turns a local git diff into a close, exact read, the way a printer
          proofs a page. Comment on the precise code, then return structured feedback
          your coding agent can act on. No forge, no account, no hosted AI.
        </p>

        <div class="install">
          <div class="cmd" role="group" aria-label="Install on macOS or Linux">
            <span class="cmd-prompt" aria-hidden="true">$</span>
            <code>{installUnix}</code>
            <button class="copy" type="button" data-copy={installUnix} aria-label="Copy install command">
              <svg class="ico-copy" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
              <svg class="ico-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
            </button>
          </div>
          <p class="install-alt">
            Windows:
            <code>{installWin}</code>
            <button class="copy-inline" type="button" data-copy={installWin} aria-label="Copy Windows install command">copy</button>
          </p>
        </div>

        <div class="hero-actions">
          <a class="btn btn-primary" href="/getting-started/installation/">
            Get started
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="btn btn-ghost" href={repo} rel="noopener">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"></path></svg>
            View on GitHub
          </a>
        </div>

        <ul class="trust" aria-label="At a glance">
          <li>local-first</li>
          <li>durable review records</li>
          <li>MCP handoff</li>
          <li>macOS · Linux · Windows</li>
        </ul>
      </div>

      <!-- hand-built diff proof — the custom mock stays; the walkthrough video is real -->
      <div class="hero-proof">
        <div class="frame diff-frame">
          <div class="frame-bar">
            <span class="frame-path">src/utils/git.ts</span>
            <span class="frame-count"><span class="add">+18</span> <span class="del">−4</span></span>
          </div>
          <div class="diff-body">
            <aside class="file-rail" aria-hidden="true">
              <div class="rail-file active">git.ts<span>+18 −4</span></div>
              <div class="rail-file">router.ts<span>+6 −0</span></div>
              <div class="rail-file">handlers.ts<span>+9 −3</span></div>
              <div class="rail-file">index.ts<span>+2 −2</span></div>
            </aside>
            <div class="diff-code">
              <div class="ln ctx"><span class="num">40</span><span class="sign"> </span><code>export function resolveRef(ref: string) {"{"}</code></div>
              <div class="ln ctx"><span class="num">41</span><span class="sign"> </span><code>  const base = ref || "HEAD";</code></div>
              <div class="ln del"><span class="num">42</span><span class="sign">−</span><code>  return runGit(["rev-parse", base]);</code></div>
              <div class="ln add"><span class="num">42</span><span class="sign">+</span><code>  const sha = runGit(["rev-parse", "--verify", base]);</code></div>
              <div class="ln add"><span class="num">43</span><span class="sign">+</span><code>  if (!sha) throw new NoSuchRef(base);</code></div>

              <div class="comment">
                <span class="comment-dot" aria-hidden="true"></span>
                <div class="comment-body">
                  <div class="comment-head">
                    <span class="comment-author">you</span>
                    <span class="pill pill-open">unresolved</span>
                  </div>
                  <p>resolveRef still throws on a fresh repo where HEAD has no commits — guard the empty case before rev-parse.</p>
                  <div class="comment-actions"><span>reply</span><span>resolve</span></div>
                </div>
              </div>

              <div class="ln add"><span class="num">44</span><span class="sign">+</span><code>  return sha.trim();</code></div>
              <div class="ln ctx"><span class="num">45</span><span class="sign"> </span><code>{"}"}</code></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== THE LOOP ===================== -->
  <section class="loop wrap" data-reveal>
    <div class="loop-head">
      <span class="eyebrow">the loop</span>
      <h2>One ritual, start to finish.</h2>
    </div>
    <ol class="loop-steps" data-stagger>
      {loop.map(([verb, gloss]) => (
        <li>
          <span class="loop-verb">{verb}</span>
          <span class="loop-gloss">{gloss}</span>
        </li>
      ))}
    </ol>
  </section>

  <!-- ===================== SPREAD: REVIEW ===================== -->
  <section class="spread wrap" data-reveal>
    <div class="spread-copy">
      <h2>Review any comparison</h2>
      <p>
        Working tree, staged changes, a branch, a commit range, or the whole
        codebase, rendered in your browser with a file tree and syntax highlighting,
        not scrolled past in the terminal. Unified or side-by-side, your choice.
      </p>
      <a class="text-link" href="/reference/cli/">
        Every command and flag
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </div>
    <div class="spread-proof">
      <div class="frame code-frame">
        <div class="frame-bar"><span class="frame-path">terminal</span></div>
        <pre class="shell">{cli.map(([c, note]) => (
<div class="shell-line"><span class="shell-prompt">$</span> <span class="shell-cmd">{c}</span><span class="shell-cmt"># {note}</span></div>
))}</pre>
      </div>
    </div>
  </section>

  <!-- ===================== SPREAD: COMMENT ===================== -->
  <section class="spread reverse wrap" data-reveal>
    <div class="spread-copy">
      <h2>Comment on the exact code</h2>
      <p>
        Click a line, or drag across line numbers for a range. Leave threaded replies,
        resolve and reopen, and mark files viewed as you go. Every note is saved to a
        durable Review Record that survives restarts and re-runs.
      </p>
      <a class="text-link" href="/guides/inline-comments/">
        Ranges, threads, and orphans
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </div>
    <div class="spread-proof">
      <div class="frame thread-frame">
        <div class="frame-bar"><span class="frame-path">client/src/lib/api.ts</span><span class="frame-count">line 88</span></div>
        <div class="thread-body">
          <div class="ln del"><span class="num">88</span><span class="sign">−</span><code>  const res = await fetch(url);</code></div>
          <div class="thread">
            <div class="msg">
              <span class="comment-dot" aria-hidden="true"></span>
              <div>
                <div class="comment-head"><span class="comment-author">you</span></div>
                <p>No timeout here — an agent hangs forever on a dead dev server.</p>
              </div>
            </div>
            <div class="msg agent">
              <span class="comment-dot agent-dot" aria-hidden="true"></span>
              <div>
                <div class="comment-head"><span class="comment-author">agent</span><span class="pill pill-done">resolved</span></div>
                <p>Added an AbortController with a 10s timeout. Pushed to the branch.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== SPREAD: AGENT ===================== -->
  <section class="spread wrap" data-reveal>
    <div class="spread-copy">
      <h2>Close the loop with your agent</h2>
      <p>
        Return the whole redline as structured feedback over a local MCP server; each
        comment carries its code context. Claude Code, Codex, or any MCP client fixes
        the code, replies inline, and requests a re-review. You refresh and sign off.
      </p>
      <a class="text-link" href="/guides/agent-feedback/">
        Wire up the MCP handoff
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </div>
    <div class="spread-proof">
      <div class="frame md-frame">
        <div class="frame-bar"><span class="frame-path">feedback.md</span><span class="frame-count">2 unresolved</span></div>
        <pre class="md"><span class="md-h">## Review feedback (2 comments)</span>

<span class="md-loc">src/utils/git.ts:42</span> <span class="pill pill-open">unresolved</span>
<span class="md-q">&gt; resolveRef throws on a fresh repo where HEAD has
&gt; no commits — guard before rev-parse.</span>

<span class="md-loc">client/src/lib/api.ts:88</span> <span class="pill pill-open">unresolved</span>
<span class="md-q">&gt; fetch has no timeout; agents hang on a dead server.</span></pre>
      </div>
    </div>
  </section>

  <!-- ===================== WALKTHROUGH (media placeholder) ===================== -->
  <section class="showcase wrap" data-reveal>
    <div class="showcase-head">
      <span class="eyebrow">see it in action</span>
      <h2>A full review, start to finish.</h2>
      <p>Open a diff, redline the exact code, and export a feedback bundle you can hand straight to an agent.</p>
    </div>
    <div class="media-frame">
      <video
        class="walkthrough"
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        poster="/media/walkthrough-poster.png"
        aria-label="A diffle review, start to finish"
      >
        <source src="/media/walkthrough.mp4" type="video/mp4" />
      </video>
    </div>
  </section>

  <!-- ===================== INSTALL CLOSE ===================== -->
  <section class="close" data-reveal>
    <div class="close-inner wrap">
      <h2>Install diffle</h2>
      <p class="close-lede">
        One self-contained binary. It embeds its own web client and needs no checkout,
        no Node, and no sidecar files. <code>git</code> on your <code>PATH</code> is the
        only prerequisite.
      </p>

      <div class="close-cmds">
        <div class="close-cmd">
          <span class="close-os">macOS · Linux</span>
          <div class="cmd">
            <span class="cmd-prompt" aria-hidden="true">$</span>
            <code>{installUnix}</code>
            <button class="copy" type="button" data-copy={installUnix} aria-label="Copy install command">
              <svg class="ico-copy" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
              <svg class="ico-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
            </button>
          </div>
        </div>
        <div class="close-cmd">
          <span class="close-os">Windows</span>
          <div class="cmd">
            <span class="cmd-prompt" aria-hidden="true">&gt;</span>
            <code>{installWin}</code>
            <button class="copy" type="button" data-copy={installWin} aria-label="Copy Windows install command">
              <svg class="ico-copy" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
              <svg class="ico-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
            </button>
          </div>
        </div>
      </div>

      <ul class="close-points" aria-label="What you get" data-stagger>
        <li><strong>Stays local.</strong> No forge, no database, no hosted AI service.</li>
        <li><strong>Always current.</strong> <code>diffle update</code> verifies and swaps in place.</li>
        <li><strong>Yours to keep.</strong> Review Records live under your data directory.</li>
      </ul>

      <a class="btn btn-primary btn-lg" href="/getting-started/quickstart/">
        Run your first review
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </div>
  </section>

  <style>
    /* ============ HERO ============ */
    .hero {
      padding-top: clamp(3rem, 7vw, 6rem);
      padding-bottom: clamp(3rem, 6vw, 5rem);
      position: relative;
      overflow: hidden;
    }
    /* a single indigo field bleeding from behind the proof — color at page scale, not a gradient headline */
    .hero::before {
      content: "";
      position: absolute;
      inset: -20% -10% auto auto;
      width: 60vw;
      height: 60vw;
      max-width: 780px;
      max-height: 780px;
      background: radial-gradient(
        circle at 70% 30%,
        color-mix(in srgb, var(--accent) 26%, transparent),
        transparent 62%
      );
      pointer-events: none;
      z-index: 0;
    }
    .hero-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      align-items: center;
      gap: clamp(2rem, 5vw, 4.5rem);
    }
    /* grid children must not grow to their (wide) intrinsic content */
    .hero-copy,
    .hero-proof {
      min-width: 0;
    }
    .hero h1 {
      font-size: clamp(2.6rem, 6vw, 4.4rem);
      letter-spacing: -0.045em;
    }
    .accent-ink {
      color: var(--accent);
    }
    .lede {
      margin-top: 1.5rem;
      max-width: 46ch;
      color: var(--muted);
      font-size: 1.08rem;
    }

    .install {
      margin-top: 2rem;
    }
    .cmd {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.7rem 0.7rem 0.7rem 0.95rem;
      font-family: var(--ff-mono);
      font-size: 0.92rem;
      max-width: 100%;
      overflow: hidden;
    }
    .cmd-prompt {
      color: var(--accent);
    }
    .cmd code {
      color: var(--text);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      flex: 1;
      min-width: 0;
    }
    .copy {
      display: inline-grid;
      place-items: center;
      width: 30px;
      height: 30px;
      flex: none;
      border-radius: 5px;
      border: 1px solid var(--border);
      background: var(--surface-2);
      color: var(--muted);
      cursor: pointer;
      transition: color 0.15s, border-color 0.15s;
    }
    .copy:hover {
      color: var(--text);
      border-color: var(--accent);
    }
    .copy .ico-check {
      display: none;
      color: var(--add-text);
    }
    .copy.copied .ico-copy {
      display: none;
    }
    .copy.copied .ico-check {
      display: block;
    }
    .install-alt {
      margin-top: 0.7rem;
      color: var(--dim);
      font-size: 0.85rem;
      font-family: var(--ff-mono);
    }
    .install-alt code {
      color: var(--muted);
    }
    .copy-inline {
      background: none;
      border: none;
      color: var(--accent);
      cursor: pointer;
      font-family: var(--ff-mono);
      font-size: 0.82rem;
      padding: 0;
      margin-left: 0.3rem;
    }
    .copy-inline.copied::after {
      content: " ✓";
    }

    .hero-actions {
      margin-top: 1.8rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .trust {
      margin: 2.2rem 0 0;
      padding: 0;
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.3rem;
      font-family: var(--ff-mono);
      font-size: 0.76rem;
      letter-spacing: 0.05em;
      color: var(--dim);
    }
    .trust li {
      position: relative;
    }
    .trust li:not(:last-child)::after {
      content: "·";
      position: absolute;
      right: -0.8rem;
      color: var(--border);
    }

    /* ============ FRAME (shared window chrome) ============ */
    .frame {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
      max-width: 100%;
      box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.5);
    }
    .frame-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.6rem 0.9rem;
      background: var(--surface-2);
      border-bottom: 1px solid var(--border);
      font-family: var(--ff-mono);
      font-size: 0.78rem;
    }
    .frame-path {
      color: var(--muted);
    }
    .frame-count {
      color: var(--dim);
    }
    .frame-count .add {
      color: var(--add-text);
    }
    .frame-count .del {
      color: var(--del-text);
    }

    /* ---- hero diff frame ---- */
    .hero-proof {
      transform: perspective(1400px) rotateY(-6deg) rotateX(2deg);
      transform-origin: left center;
    }
    .diff-body {
      display: grid;
      grid-template-columns: 148px 1fr;
    }
    .file-rail {
      border-right: 1px solid var(--divider);
      padding: 0.5rem 0.35rem;
      background: var(--bg);
      font-family: var(--ff-mono);
      font-size: 0.74rem;
    }
    .rail-file {
      display: flex;
      justify-content: space-between;
      gap: 0.4rem;
      padding: 0.35rem 0.5rem;
      border-radius: 5px;
      color: var(--muted);
      white-space: nowrap;
    }
    .rail-file span {
      color: var(--dim);
      font-size: 0.68rem;
    }
    .rail-file.active {
      background: var(--surface-2);
      color: var(--text);
    }
    .diff-code {
      font-family: var(--ff-mono);
      font-size: 0.8rem;
      line-height: 1.9;
      overflow: hidden;
      padding: 0.35rem 0;
    }
    .ln {
      display: grid;
      grid-template-columns: 2.4rem 1.2rem 1fr;
      align-items: baseline;
    }
    .ln .num {
      text-align: right;
      padding-right: 0.6rem;
      color: var(--dim);
      user-select: none;
    }
    .ln .sign {
      text-align: center;
      user-select: none;
    }
    .ln code {
      white-space: pre;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .ln.ctx code {
      color: var(--muted);
    }
    .ln.add {
      background: var(--add-bg);
    }
    .ln.add .sign,
    .ln.add code {
      color: var(--add-text);
    }
    .ln.del {
      background: var(--del-bg);
    }
    .ln.del .sign,
    .ln.del code {
      color: var(--del-text);
    }

    /* ---- inline comment (the redline) ---- */
    .comment {
      display: flex;
      gap: 0.6rem;
      margin: 0.5rem 0.7rem 0.5rem 3rem;
      padding: 0.65rem 0.75rem;
      background: color-mix(in srgb, var(--accent) 7%, var(--surface));
      border: 1px solid var(--border);
      border-radius: 7px;
      font-family: var(--ff-sans);
    }
    .comment-dot {
      flex: none;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: color-mix(in srgb, var(--accent) 30%, var(--surface-2));
      border: 1px solid var(--accent);
    }
    .comment-body {
      font-size: 0.82rem;
      line-height: 1.5;
    }
    .comment-head {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.25rem;
    }
    .comment-author {
      font-weight: 600;
      font-size: 0.8rem;
    }
    .comment-body p {
      color: var(--text);
    }
    .comment-actions {
      display: flex;
      gap: 0.9rem;
      margin-top: 0.45rem;
      font-family: var(--ff-mono);
      font-size: 0.72rem;
      color: var(--accent);
    }
    .pill {
      font-family: var(--ff-mono);
      font-size: 0.62rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.12rem 0.4rem;
      border-radius: 4px;
    }
    .pill-open {
      background: var(--mod-badge-bg);
      color: var(--mod-badge-text);
    }
    .pill-done {
      background: var(--add-gutter);
      color: var(--add-text);
    }

    /* ============ THE LOOP ============ */
    .loop {
      padding-block: clamp(3rem, 6vw, 5rem);
      border-top: 1px solid var(--divider);
    }
    .loop-head {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      margin-bottom: 2rem;
    }
    .loop-head h2 {
      font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    }
    .loop-steps {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
    }
    .loop-steps li {
      padding: 1.1rem 1rem;
      border-right: 1px solid var(--divider);
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .loop-steps li:last-child {
      border-right: none;
    }
    .loop-verb {
      font-family: var(--ff-mono);
      font-size: 0.9rem;
      color: var(--accent);
      font-weight: 500;
    }
    .loop-gloss {
      font-size: 0.86rem;
      color: var(--muted);
      line-height: 1.45;
    }

    /* ============ SPREADS ============ */
    .spread {
      padding-block: clamp(3rem, 6vw, 5rem);
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      align-items: center;
      gap: clamp(2rem, 5vw, 4.5rem);
      border-top: 1px solid var(--divider);
    }
    .spread-copy,
    .spread-proof {
      min-width: 0;
    }
    .spread.reverse .spread-copy {
      order: 2;
    }
    .spread-copy h2 {
      font-size: clamp(1.8rem, 3.6vw, 2.6rem);
      margin-bottom: 1.1rem;
    }
    .spread-copy p {
      color: var(--muted);
      max-width: 42ch;
      font-size: 1.02rem;
    }
    .text-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4ch;
      margin-top: 1.3rem;
      color: var(--accent);
      font-weight: 500;
      font-size: 0.95rem;
    }
    .text-link svg {
      transition: transform 0.16s ease;
    }
    .text-link:hover svg {
      transform: translateX(3px);
    }

    /* shell / code frame */
    .shell,
    .md {
      margin: 0;
      padding: 1rem 1.1rem;
      font-family: var(--ff-mono);
      font-size: 0.82rem;
      line-height: 1.85;
      overflow-x: auto;
    }
    .shell-line {
      white-space: pre;
    }
    .shell-prompt {
      color: var(--accent);
    }
    .shell-cmd {
      color: var(--text);
    }
    .shell-cmt {
      color: var(--dim);
      margin-left: 1.2rem;
    }

    /* thread frame */
    .thread-body {
      padding: 0.5rem 0 0.8rem;
    }
    .thread-body .ln {
      font-family: var(--ff-mono);
      font-size: 0.82rem;
      line-height: 2;
    }
    .thread {
      margin: 0.6rem 0.9rem 0.2rem;
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
    }
    .msg {
      display: flex;
      gap: 0.6rem;
      padding: 0.7rem 0.8rem;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 0.85rem;
      line-height: 1.5;
    }
    .msg p {
      color: var(--text);
    }
    .agent-dot {
      background: color-mix(in srgb, var(--add-text) 34%, var(--surface-2));
      border-color: var(--add-text);
    }

    /* markdown / feedback frame */
    .md {
      color: var(--muted);
      white-space: pre-wrap;
    }
    .md-h {
      color: var(--text);
      font-weight: 600;
    }
    .md-loc {
      color: var(--accent);
    }
    .md-q {
      color: var(--muted);
    }

    /* ============ SHOWCASE / MEDIA SLOT ============ */
    .showcase {
      padding-block: clamp(3rem, 6vw, 5rem);
      border-top: 1px solid var(--divider);
    }
    .showcase-head {
      max-width: 54ch;
      margin-bottom: 2rem;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .showcase-head h2 {
      font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    }
    .showcase-head p {
      color: var(--muted);
    }
    .media-frame {
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      background: var(--surface);
      box-shadow: 0 30px 70px -28px rgba(0, 0, 0, 0.55);
      line-height: 0;
    }
    .walkthrough {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      background: var(--surface-2);
    }

    /* ============ INSTALL CLOSE ============ */
    .close {
      border-top: 1px solid var(--divider);
      padding-block: clamp(3.5rem, 7vw, 6rem);
      background:
        radial-gradient(
          80% 130% at 50% 0%,
          color-mix(in srgb, var(--accent) 12%, transparent),
          transparent 60%
        );
    }
    .close-inner {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .close h2 {
      font-size: clamp(2.1rem, 4.6vw, 3.2rem);
    }
    .close-lede {
      margin-top: 1.1rem;
      max-width: 52ch;
      color: var(--muted);
      font-size: 1.05rem;
    }
    .close-lede code,
    .close-points code {
      font-size: 0.9em;
      color: var(--text);
      background: var(--surface-2);
      padding: 0.05em 0.4em;
      border-radius: 4px;
    }
    .close-cmds {
      margin-top: 2rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      width: 100%;
      max-width: 760px;
      text-align: left;
    }
    .close-cmd {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      min-width: 0;
    }
    .close-os {
      font-family: var(--ff-mono);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--dim);
    }
    .close-points {
      margin: 2.2rem 0 0;
      padding: 0;
      list-style: none;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.2rem;
      max-width: 760px;
      width: 100%;
      text-align: left;
    }
    .close-points li {
      color: var(--muted);
      font-size: 0.92rem;
      line-height: 1.5;
      padding-top: 0.9rem;
      border-top: 1px solid var(--border);
    }
    .close-points strong {
      color: var(--text);
      font-weight: 600;
      display: block;
      margin-bottom: 0.2rem;
    }
    .btn-lg {
      margin-top: 2.4rem;
      padding: 0.9rem 1.5rem;
      font-size: 1rem;
    }

    /* ============ MOTION ============ */
    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes fade-in {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    /* hero assembles on load: copy rises in sequence, the diff writes itself line by line */
    @media (prefers-reduced-motion: no-preference) {
      .hero-copy > * {
        animation: rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
      }
      .hero-copy > h1 {
        animation-delay: 0.04s;
      }
      .hero-copy > .lede {
        animation-delay: 0.12s;
      }
      .hero-copy > .install {
        animation-delay: 0.2s;
      }
      .hero-copy > .hero-actions {
        animation-delay: 0.28s;
      }
      .hero-copy > .trust {
        animation-delay: 0.36s;
      }
      .hero-proof {
        animation: fade-in 0.9s ease 0.12s both;
      }
      .diff-code > * {
        animation: rise 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
      }
      .diff-code > *:nth-child(1) {
        animation-delay: 0.5s;
      }
      .diff-code > *:nth-child(2) {
        animation-delay: 0.56s;
      }
      .diff-code > *:nth-child(3) {
        animation-delay: 0.62s;
      }
      .diff-code > *:nth-child(4) {
        animation-delay: 0.68s;
      }
      .diff-code > *:nth-child(5) {
        animation-delay: 0.74s;
      }
      .diff-code > *:nth-child(6) {
        animation-delay: 0.82s;
      }
      .diff-code > *:nth-child(7) {
        animation-delay: 0.9s;
      }
      .diff-code > *:nth-child(8) {
        animation-delay: 0.96s;
      }
    }

    /* staggered list reveals (loop steps, install points) driven by the shared observer */
    [data-stagger] > * {
      opacity: 0;
      transform: translateY(12px);
      transition:
        opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    }
    [data-stagger].in > * {
      opacity: 1;
      transform: none;
    }
    [data-stagger].in > *:nth-child(2) {
      transition-delay: 0.06s;
    }
    [data-stagger].in > *:nth-child(3) {
      transition-delay: 0.12s;
    }
    [data-stagger].in > *:nth-child(4) {
      transition-delay: 0.18s;
    }
    [data-stagger].in > *:nth-child(5) {
      transition-delay: 0.24s;
    }
    [data-stagger].in > *:nth-child(6) {
      transition-delay: 0.3s;
    }
    @media (prefers-reduced-motion: reduce) {
      [data-stagger] > * {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }

    /* ============ RESPONSIVE ============ */
    @media (max-width: 900px) {
      .hero-grid,
      .spread {
        grid-template-columns: 1fr;
      }
      .hero-proof {
        transform: none;
      }
      .spread.reverse .spread-copy {
        order: 0;
      }
      .loop-steps {
        grid-template-columns: repeat(3, 1fr);
      }
      .loop-steps li:nth-child(3n) {
        border-right: none;
      }
      .loop-steps li:nth-child(-n + 3) {
        border-bottom: 1px solid var(--divider);
      }
    }
    @media (max-width: 620px) {
      .hero h1 {
        font-size: clamp(2.2rem, 10vw, 2.9rem);
      }
      .hero h1 br {
        display: none;
      }
      .loop-steps {
        grid-template-columns: 1fr 1fr;
      }
      .loop-steps li {
        border-right: 1px solid var(--divider);
      }
      .loop-steps li:nth-child(2n) {
        border-right: none;
      }
      .close-cmds,
      .close-points {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Landing>
