{
  "name": "diffle",
  "version": "0.17.1",
  "description": "Local git diff viewer with inline comments and structured agent feedback",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "diffle": "src/index.ts",
    "loupe": "src/index.ts"
  },
  "scripts": {
    "start": "bun run client:build && bun src/index.ts",
    "dev": "bun scripts/dev.ts",
    "preview": "bun run client:build && bun src/index.ts",
    "test": "bun test",
    "client:build": "vite build",
    "client:test": "vitest run",
    "client:check": "cd client && svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "playwright test",
    "build:binary": "bun scripts/build-binary.ts",
    "build:release": "bun scripts/build-release.ts",
    "mcp:serve": "bun src/mcp/index.ts",
    "mcpb:stage": "bun run build:binary && bun scripts/stage-mcpb.ts",
    "mcpb:validate": "bun run mcpb:stage && mcpb validate mcpb/manifest.json",
    "mcpb:pack": "bun run mcpb:stage && mcpb pack mcpb dist/diffle.mcpb"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@lucide/svelte": "1.47.0",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/bun": "latest",
    "clsx": "2.1.1",
    "dompurify": "3.4.15",
    "highlight.js": "11.12.0",
    "jsdom": "30.1.0",
    "marked": "18.0.13",
    "playwright": "1.62.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.5.2"
  }
}
