{
  "name": "nittle",
  "version": "0.28.1",
  "description": "Local git diff viewer with inline comments and structured agent feedback",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "nittle": "src/index.ts"
  },
  "scripts": {
    "start": "bun run client:build && bun src/index.ts",
    "dev": "bun scripts/dev.ts",
    "preview": "bun run client:build && bun src/index.ts",
    "test": "bun test",
    "client:build": "vite build",
    "client:test": "vitest run",
    "test:agent-loop": "bun test tests/agentLoop.test.ts --timeout 45000",
    "client:check": "cd client && svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "playwright test --project=behavior",
    "test:e2e:visual": "playwright test --project=visual",
    "test:e2e:docker": "bun scripts/e2e-docker.ts",
    "test:e2e:docker:update": "bun scripts/e2e-docker.ts --update",
    "build:binary": "bun scripts/build-binary.ts",
    "build:release": "bun scripts/build-release.ts",
    "mcp:serve": "bun src/mcp/index.ts",
    "mcpb:stage": "bun run build:binary && bun scripts/stage-mcpb.ts",
    "mcpb:validate": "bun run mcpb:stage && mcpb validate mcpb/manifest.json",
    "mcpb:pack": "bun run mcpb:stage && mcpb pack mcpb dist/nittle.mcpb"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@lucide/svelte": "1.48.0",
    "@number-flow/svelte": "0.4.2",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/bun": "latest",
    "clsx": "2.1.1",
    "dompurify": "3.4.16",
    "jsdom": "30.1.1",
    "marked": "18.0.14",
    "playwright": "1.63.0",
    "shiki": "4.4.3",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "fast-uri": "3.1.8",
    "hono": "4.13.7",
    "ip-address": "10.7.1",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2",
    "tmp": "0.2.7"
  }
}
