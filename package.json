{
  "name": "nittle",
  "version": "0.33.0",
  "description": "Local git diff viewer with inline comments and structured agent feedback",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "nittle": "src/index.ts"
  },
  "scripts": {
    "start": "bun run client:build && bun --no-env-file --config=bunfig.toml src/index.ts",
    "dev": "bun --no-env-file --config=bunfig.toml scripts/dev.ts",
    "preview": "bun run client:build && bun --no-env-file --config=bunfig.toml src/index.ts",
    "test": "bun test",
    "client:build": "vite build",
    "client:test": "vitest run",
    "test:agent-loop": "bun test tests/agentLoop.test.ts --timeout 45000",
    "client:check": "cd client && svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "playwright test --project=behavior",
    "test:e2e:visual": "playwright test --project=visual",
    "test:e2e:docker": "bun scripts/e2e-docker.ts",
    "test:e2e:docker:update": "bun scripts/e2e-docker.ts --update",
    "build:binary": "bun scripts/build-binary.ts",
    "build:release": "bun scripts/build-release.ts",
    "mcp:serve": "bun --no-env-file --config=bunfig.toml src/mcp/index.ts",
    "mcpb:stage": "bun run build:binary && bun scripts/stage-mcpb.ts",
    "mcpb:validate": "bun run mcpb:stage && mcpb validate mcpb/manifest.json",
    "mcpb:pack": "bun run mcpb:stage && mcpb pack mcpb dist/nittle.mcpb"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@lucide/svelte": "1.61.0",
    "@number-flow/svelte": "0.4.2",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/bun": "latest",
    "clsx": "2.1.1",
    "dompurify": "3.4.17",
    "jsdom": "30.1.3",
    "marked": "18.1.1",
    "playwright": "1.64.1",
    "shiki": "4.5.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "overrides": {
    "@hono/node-server": "2.1.5",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "hono": "4.13.14",
    "ip-address": "10.7.5",
    "node-forge": "1.4.2",
    "proxy-addr": "2.0.8",
    "qs": "6.17.1",
    "source-map-js": "1.2.2",
    "tmp": "0.2.7",
    "undici": "8.12.3"
  }
}
