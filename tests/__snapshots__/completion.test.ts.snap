// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`completion scripts bash output matches the snapshot 1`] = `
"# bash completion for nittle
# install: eval "$(nittle completion --shell bash)"
_nittle_offer() {
  [[ "$1" == "$cur"* ]] && COMPREPLY+=("$1")
}
# a comma-separated list value: keep what was typed through the last comma, complete the rest
_nittle_offer_list() {
  local head="\${cur%"\${cur##*,}"}" tail="\${cur##*,}"
  [[ "$1" == "$tail"* ]] && COMPREPLY+=("$head$1")
}
_nittle() {
  local cur prev cmd=review sub="" scope lead=0 flags="" subs="" words="" wantsrefs=0 npos=0 skip=0 word ref i
  cur="\${COMP_WORDS[COMP_CWORD]}"
  prev="\${COMP_WORDS[COMP_CWORD-1]}"
  COMPREPLY=()
  if (( COMP_CWORD > 1 )); then
    case "\${COMP_WORDS[1]}" in
      show|mcp|hook|sessions|cleanup|update|doctor|setup|lsp|completion) cmd="\${COMP_WORDS[1]}"; lead=1 ;;
    esac
  fi
  case "$cmd" in
    mcp)
      subs="serve list restart"
      if (( COMP_CWORD > 2 )); then case "\${COMP_WORDS[2]}" in serve|list|restart) sub="\${COMP_WORDS[2]}"; lead=2 ;; esac; fi ;;
    hook)
      subs="stop"
      if (( COMP_CWORD > 2 )); then case "\${COMP_WORDS[2]}" in stop) sub="\${COMP_WORDS[2]}"; lead=2 ;; esac; fi ;;
    lsp)
      subs="set unset"
      if (( COMP_CWORD > 2 )); then case "\${COMP_WORDS[2]}" in set|unset) sub="\${COMP_WORDS[2]}"; lead=2 ;; esac; fi ;;
  esac
  scope="$cmd\${sub:+ $sub}"
  case "$scope" in
    'review') flags="-p --port --no-open --wait --json --no-lsp --lsp --review-id -v --version --license -h --help" ;;
    'show') flags="-p --port --no-open --no-lsp --lsp -v --version --license -h --help" ;;
    'mcp') flags="-h --help" ;;
    'mcp serve') flags="-v --version --license -h --help" ;;
    'mcp list') flags="-v --version --license -h --help" ;;
    'mcp restart') flags="-v --version --license --yes -h --help" ;;
    'hook') flags="-h --help" ;;
    'hook stop') flags="-v --version --license --agent -h --help" ;;
    'sessions') flags="-v --version --license -h --help" ;;
    'cleanup') flags="-v --version --license --yes --all -h --help" ;;
    'update') flags="-v --version --license --check -h --help" ;;
    'doctor') flags="-v --version --license --yes --fix -h --help" ;;
    'setup') flags="-v --version --license --agents --remove --yes -h --help" ;;
    'lsp') flags="-v --version --license -h --help" ;;
    'lsp set') flags="-v --version --license -h --help" ;;
    'lsp unset') flags="-v --version --license -h --help" ;;
    'completion') flags="-v --version --license --shell -h --help" ;;
  esac
  case "$cmd" in
    review) words="staged browse"; wantsrefs=1 ;;
    show) words=""; wantsrefs=1 ;;
  esac
  case "$prev" in
    -p|--port) return ;;
    --lsp) return ;;
    --review-id) return ;;
    --agent) for word in codex claude-code; do _nittle_offer "$word"; done; return ;;
    --agents) for word in claude codex cursor gemini vscode windsurf opencode zed copilot; do _nittle_offer_list "$word"; done; return ;;
    --shell) for word in bash zsh fish powershell; do _nittle_offer "$word"; done; return ;;
  esac
  for (( i = lead + 1; i < COMP_CWORD; i++ )); do
    word="\${COMP_WORDS[i]}"
    if (( skip )); then skip=0; continue; fi
    case "$word" in
      -p|--port|--lsp|--review-id|--agent|--agents|--shell) skip=1 ;;
      -*) ;;
      *) npos=$(( npos + 1 )) ;;
    esac
  done
  if [[ "$cur" == -* ]]; then
    for word in $flags; do _nittle_offer "$word"; done
    return
  fi
  if [[ "$cmd" == review && "$prev" == browse ]]; then
    while IFS= read -r word; do COMPREPLY+=("$word"); done < <(compgen -d -- "$cur")
    return
  fi
  if (( COMP_CWORD == 1 )); then
    for word in show mcp hook sessions cleanup update doctor setup lsp completion; do _nittle_offer "$word"; done
  fi
  if (( COMP_CWORD == 2 )); then
    for word in $subs; do _nittle_offer "$word"; done
  fi
  if (( wantsrefs && npos == 0 )); then
    for word in $words; do _nittle_offer "$word"; done
    while IFS= read -r ref; do _nittle_offer "$ref"; done < <(command git for-each-ref '--format=%(refname:short)' refs/heads refs/remotes refs/tags 2>/dev/null)
  fi
}
complete -F _nittle nittle
"
`;

exports[`completion scripts zsh output matches the snapshot 1`] = `
"#compdef nittle
# zsh completion for nittle
# install: source <(nittle completion --shell zsh)    (after compinit)
# or save the output as _nittle in a directory on your $fpath
_nittle() {
  local cmd=review sub="" scope lead=0 npos=0 skip=0 wantsrefs=0 word i
  local -a flags_ subs_ words_ refs cmds_
  cmds_=('show:review one commit against its first parent' 'mcp:run or manage the local MCP server agents talk to' 'hook:experimental agent stop hook that opens a review of the working tree' 'sessions:list running review sessions (host, port, age, live/stale)' 'cleanup:stop stale sessions and finished reviews' 'update:download and install the latest release' 'doctor:check for stale agent plugins, old MCP configs, and an unfinished migration' 'setup:wire nittle into your coding agents (plugin or MCP config)' 'lsp:show which language server each language gets, and override it' 'completion:print a tab-completion script for your shell')
  if (( CURRENT > 2 )); then
    case "\${words[2]}" in
      show|mcp|hook|sessions|cleanup|update|doctor|setup|lsp|completion) cmd="\${words[2]}"; lead=1 ;;
    esac
  fi
  case "$cmd" in
    mcp)
      subs_=(serve list restart)
      if (( CURRENT > 3 )); then case "\${words[3]}" in serve|list|restart) sub="\${words[3]}"; lead=2 ;; esac; fi ;;
    hook)
      subs_=(stop)
      if (( CURRENT > 3 )); then case "\${words[3]}" in stop) sub="\${words[3]}"; lead=2 ;; esac; fi ;;
    lsp)
      subs_=(set unset)
      if (( CURRENT > 3 )); then case "\${words[3]}" in set|unset) sub="\${words[3]}"; lead=2 ;; esac; fi ;;
  esac
  scope="$cmd\${sub:+ $sub}"
  case "$scope" in
    'review') flags_=('-p:serve on a fixed port (default: any free port)' '--port:serve on a fixed port (default: any free port)' '--no-open:don'\\''t open the browser automatically' '--wait:block until feedback is returned, then print the prompt on stdout' '--json:with --wait, print the review record as JSON instead of the prompt' '--no-lsp:start no language servers' '--lsp:use this server for one language this run; an empty command disables it (e.g. rust=rust-analyzer)' '--review-id:open an existing durable Review Record' '-v:print the installed version' '--version:print the installed version' '--license:print the bundled MIT license notice' '-h:show help' '--help:show help') ;;
    'show') flags_=('-p:serve on a fixed port (default: any free port)' '--port:serve on a fixed port (default: any free port)' '--no-open:don'\\''t open the browser automatically' '--no-lsp:start no language servers' '--lsp:use this server for one language this run; an empty command disables it (e.g. rust=rust-analyzer)' '-v:print the installed version' '--version:print the installed version' '--license:print the bundled MIT license notice' '-h:show help' '--help:show help') ;;
    'mcp') flags_=('-h:show help' '--help:show help') ;;
    'mcp serve') flags_=('-v:print the installed version' '--version:print the installed version' '--license:print the bundled MIT license notice' '-h:show help' '--help:show help') ;;
    'mcp list') flags_=('-v:print the installed version' '--version:print the installed version' '--license:print the bundled MIT license notice' '-h:show help' '--help:show help') ;;
    'mcp restart') flags_=('-v:print the installed version' '--version:print the installed version' '--license:print the bundled MIT license notice' '--yes:skip the confirmation prompt' '-h:show help' '--help:show help') ;;
    'hook') flags_=('-h:show help' '--help:show help') ;;
    'hook stop') flags_=('-v:print the installed version' '--version:print the installed version' '--license:print the bundled MIT license notice' '--agent:the agent calling the hook: codex or claude-code' '-h:show help' '--help:show help') ;;
    'sessions') flags_=('-v:print the installed version' '--version:print the installed version' '--license:print the bundled MIT license notice' '-h:show help' '--help:show help') ;;
    'cleanup') flags_=('-v:print the installed version' '--version:print the installed version' '--license:print the bundled MIT license notice' '--yes:skip the confirmation prompt' '--all:also stop active (not just finished/stale) sessions' '-h:show help' '--help:show help') ;;
    'update') flags_=('-v:print the installed version' '--version:print the installed version' '--license:print the bundled MIT license notice' '--check:only report whether a newer release exists' '-h:show help' '--help:show help') ;;
    'doctor') flags_=('-v:print the installed version' '--version:print the installed version' '--license:print the bundled MIT license notice' '--yes:skip the confirmation prompt' '--fix:run the repair commands through the \`claude\` cli' '-h:show help' '--help:show help') ;;
    'setup') flags_=('-v:print the installed version' '--version:print the installed version' '--license:print the bundled MIT license notice' '--agents:comma-separated agent ids, skips the prompt (e.g. claude,cursor)' '--remove:unwire nittle instead' '--yes:skip the confirmation prompt' '-h:show help' '--help:show help') ;;
    'lsp') flags_=('-v:print the installed version' '--version:print the installed version' '--license:print the bundled MIT license notice' '-h:show help' '--help:show help') ;;
    'lsp set') flags_=('-v:print the installed version' '--version:print the installed version' '--license:print the bundled MIT license notice' '-h:show help' '--help:show help') ;;
    'lsp unset') flags_=('-v:print the installed version' '--version:print the installed version' '--license:print the bundled MIT license notice' '-h:show help' '--help:show help') ;;
    'completion') flags_=('-v:print the installed version' '--version:print the installed version' '--license:print the bundled MIT license notice' '--shell:shell to generate for: bash, zsh, fish, powershell' '-h:show help' '--help:show help') ;;
  esac
  case "$cmd" in
    review) words_=('staged' 'browse'); wantsrefs=1 ;;
    show) words_=(); wantsrefs=1 ;;
  esac
  case "\${words[CURRENT-1]}" in
    -p|--port) return 0 ;;
    --lsp) return 0 ;;
    --review-id) return 0 ;;
    --agent) compadd -- codex claude-code; return 0 ;;
    --agents) compset -P '*,'; compadd -- claude codex cursor gemini vscode windsurf opencode zed copilot; return 0 ;;
    --shell) compadd -- bash zsh fish powershell; return 0 ;;
  esac
  for (( i = lead + 2; i < CURRENT; i++ )); do
    word="\${words[i]}"
    if (( skip )); then skip=0; continue; fi
    case "$word" in
      -p|--port|--lsp|--review-id|--agent|--agents|--shell) skip=1 ;;
      -*) ;;
      *) npos=$(( npos + 1 )) ;;
    esac
  done
  if [[ "$PREFIX" == -* ]]; then
    _describe -t options 'option' flags_
    return 0
  fi
  if [[ "$cmd" == review && "\${words[CURRENT-1]}" == browse ]]; then
    _path_files -/
    return 0
  fi
  (( CURRENT == 2 )) && _describe -t commands 'command' cmds_
  (( CURRENT == 3 )) && compadd -a subs_
  if (( wantsrefs && npos == 0 )); then
    refs=(\${(f)"$(command git for-each-ref '--format=%(refname:short)' refs/heads refs/remotes refs/tags 2>/dev/null)"})
    compadd -a words_
    compadd -a refs
  fi
  return 0
}
if [[ "$funcstack[1]" == "_nittle" ]]; then
  _nittle "$@"
elif (( $+functions[compdef] )); then
  compdef _nittle nittle
fi
"
`;

exports[`completion scripts fish output matches the snapshot 1`] = `
"# fish completion for nittle
# install: nittle completion --shell fish | source
# or save it as ~/.config/fish/completions/nittle.fish
function __nittle_cmd
    set -l words (commandline -opc)
    set -e words[1]
    if set -q words[1]; and contains -- $words[1] show mcp hook sessions cleanup update doctor setup lsp completion
        echo $words[1]
    else
        echo review
    end
end
function __nittle_scope
    set -l words (commandline -opc)
    set -e words[1]
    set -l cmd (__nittle_cmd)
    if test "$cmd" = mcp; and set -q words[2]; and contains -- $words[2] serve list restart
        echo "$cmd $words[2]"; return
    end
    if test "$cmd" = hook; and set -q words[2]; and contains -- $words[2] stop
        echo "$cmd $words[2]"; return
    end
    if test "$cmd" = lsp; and set -q words[2]; and contains -- $words[2] set unset
        echo "$cmd $words[2]"; return
    end
    echo $cmd
end
function __nittle_scope_is
    test (__nittle_scope) = "$argv[1]"
end
function __nittle_args
    set -l words (commandline -opc)
    set -e words[1]
    set -l scope (__nittle_scope)
    set -l lead 0
    test "$scope" != review; and set lead (count (string split ' ' -- $scope))
    set -l seen 0
    set -l skip 0
    for word in $words
        set seen (math $seen + 1)
        test $seen -le $lead; and continue
        if test $skip -eq 1
            set skip 0
        else if contains -- $word -p --port --lsp --review-id --agent --agents --shell
            set skip 1
        else if not string match -q -- '-*' $word
            echo $word
        end
    end
end
function __nittle_at_start
    test (count (commandline -opc)) -eq 1
end
function __nittle_needs_sub
    test (count (commandline -opc)) -eq 2; and test (__nittle_cmd) = $argv[1]
end
function __nittle_wants_ref
    contains -- (__nittle_cmd) review show; and test (count (__nittle_args)) -eq 0
end
function __nittle_wants_review_word
    test (__nittle_cmd) = review; and test (count (__nittle_args)) -eq 0
end
function __nittle_list_values
    set -l token (commandline -ct)
    set -l head (string replace -r '[^,]*$' '' -- "$token")
    for value in $argv
        echo "$head$value"
    end
end
function __nittle_refs
    command git for-each-ref '--format=%(refname:short)' refs/heads refs/remotes refs/tags 2>/dev/null
end

complete -c nittle -f
complete -c nittle -n '__nittle_at_start' -a show -d 'review one commit against its first parent'
complete -c nittle -n '__nittle_at_start' -a mcp -d 'run or manage the local MCP server agents talk to'
complete -c nittle -n '__nittle_at_start' -a hook -d 'experimental agent stop hook that opens a review of the working tree'
complete -c nittle -n '__nittle_at_start' -a sessions -d 'list running review sessions (host, port, age, live/stale)'
complete -c nittle -n '__nittle_at_start' -a cleanup -d 'stop stale sessions and finished reviews'
complete -c nittle -n '__nittle_at_start' -a update -d 'download and install the latest release'
complete -c nittle -n '__nittle_at_start' -a doctor -d 'check for stale agent plugins, old MCP configs, and an unfinished migration'
complete -c nittle -n '__nittle_at_start' -a setup -d 'wire nittle into your coding agents (plugin or MCP config)'
complete -c nittle -n '__nittle_at_start' -a lsp -d 'show which language server each language gets, and override it'
complete -c nittle -n '__nittle_at_start' -a completion -d 'print a tab-completion script for your shell'
complete -c nittle -n '__nittle_scope_is "review"' -s p -l port -x -d 'serve on a fixed port (default: any free port)'
complete -c nittle -n '__nittle_scope_is "review"' -l no-open -d 'don\\'t open the browser automatically'
complete -c nittle -n '__nittle_scope_is "review"' -l wait -d 'block until feedback is returned, then print the prompt on stdout'
complete -c nittle -n '__nittle_scope_is "review"' -l json -d 'with --wait, print the review record as JSON instead of the prompt'
complete -c nittle -n '__nittle_scope_is "review"' -l no-lsp -d 'start no language servers'
complete -c nittle -n '__nittle_scope_is "review"' -l lsp -x -d 'use this server for one language this run; an empty command disables it (e.g. rust=rust-analyzer)'
complete -c nittle -n '__nittle_scope_is "review"' -l review-id -x -d 'open an existing durable Review Record'
complete -c nittle -n '__nittle_scope_is "review"' -s v -l version -d 'print the installed version'
complete -c nittle -n '__nittle_scope_is "review"' -l license -d 'print the bundled MIT license notice'
complete -c nittle -n '__nittle_scope_is "review"' -s h -l help -d 'show help'
complete -c nittle -n '__nittle_scope_is "show"' -s p -l port -x -d 'serve on a fixed port (default: any free port)'
complete -c nittle -n '__nittle_scope_is "show"' -l no-open -d 'don\\'t open the browser automatically'
complete -c nittle -n '__nittle_scope_is "show"' -l no-lsp -d 'start no language servers'
complete -c nittle -n '__nittle_scope_is "show"' -l lsp -x -d 'use this server for one language this run; an empty command disables it (e.g. rust=rust-analyzer)'
complete -c nittle -n '__nittle_scope_is "show"' -s v -l version -d 'print the installed version'
complete -c nittle -n '__nittle_scope_is "show"' -l license -d 'print the bundled MIT license notice'
complete -c nittle -n '__nittle_scope_is "show"' -s h -l help -d 'show help'
complete -c nittle -n '__nittle_scope_is "mcp"' -s h -l help -d 'show help'
complete -c nittle -n '__nittle_scope_is "mcp serve"' -s v -l version -d 'print the installed version'
complete -c nittle -n '__nittle_scope_is "mcp serve"' -l license -d 'print the bundled MIT license notice'
complete -c nittle -n '__nittle_scope_is "mcp serve"' -s h -l help -d 'show help'
complete -c nittle -n '__nittle_scope_is "mcp list"' -s v -l version -d 'print the installed version'
complete -c nittle -n '__nittle_scope_is "mcp list"' -l license -d 'print the bundled MIT license notice'
complete -c nittle -n '__nittle_scope_is "mcp list"' -s h -l help -d 'show help'
complete -c nittle -n '__nittle_scope_is "mcp restart"' -s v -l version -d 'print the installed version'
complete -c nittle -n '__nittle_scope_is "mcp restart"' -l license -d 'print the bundled MIT license notice'
complete -c nittle -n '__nittle_scope_is "mcp restart"' -l yes -d 'skip the confirmation prompt'
complete -c nittle -n '__nittle_scope_is "mcp restart"' -s h -l help -d 'show help'
complete -c nittle -n '__nittle_scope_is "hook"' -s h -l help -d 'show help'
complete -c nittle -n '__nittle_scope_is "hook stop"' -s v -l version -d 'print the installed version'
complete -c nittle -n '__nittle_scope_is "hook stop"' -l license -d 'print the bundled MIT license notice'
complete -c nittle -n '__nittle_scope_is "hook stop"' -l agent -x -a 'codex claude-code' -d 'the agent calling the hook: codex or claude-code'
complete -c nittle -n '__nittle_scope_is "hook stop"' -s h -l help -d 'show help'
complete -c nittle -n '__nittle_scope_is "sessions"' -s v -l version -d 'print the installed version'
complete -c nittle -n '__nittle_scope_is "sessions"' -l license -d 'print the bundled MIT license notice'
complete -c nittle -n '__nittle_scope_is "sessions"' -s h -l help -d 'show help'
complete -c nittle -n '__nittle_scope_is "cleanup"' -s v -l version -d 'print the installed version'
complete -c nittle -n '__nittle_scope_is "cleanup"' -l license -d 'print the bundled MIT license notice'
complete -c nittle -n '__nittle_scope_is "cleanup"' -l yes -d 'skip the confirmation prompt'
complete -c nittle -n '__nittle_scope_is "cleanup"' -l all -d 'also stop active (not just finished/stale) sessions'
complete -c nittle -n '__nittle_scope_is "cleanup"' -s h -l help -d 'show help'
complete -c nittle -n '__nittle_scope_is "update"' -s v -l version -d 'print the installed version'
complete -c nittle -n '__nittle_scope_is "update"' -l license -d 'print the bundled MIT license notice'
complete -c nittle -n '__nittle_scope_is "update"' -l check -d 'only report whether a newer release exists'
complete -c nittle -n '__nittle_scope_is "update"' -s h -l help -d 'show help'
complete -c nittle -n '__nittle_scope_is "doctor"' -s v -l version -d 'print the installed version'
complete -c nittle -n '__nittle_scope_is "doctor"' -l license -d 'print the bundled MIT license notice'
complete -c nittle -n '__nittle_scope_is "doctor"' -l yes -d 'skip the confirmation prompt'
complete -c nittle -n '__nittle_scope_is "doctor"' -l fix -d 'run the repair commands through the \`claude\` cli'
complete -c nittle -n '__nittle_scope_is "doctor"' -s h -l help -d 'show help'
complete -c nittle -n '__nittle_scope_is "setup"' -s v -l version -d 'print the installed version'
complete -c nittle -n '__nittle_scope_is "setup"' -l license -d 'print the bundled MIT license notice'
complete -c nittle -n '__nittle_scope_is "setup"' -l agents -x -a '(__nittle_list_values claude codex cursor gemini vscode windsurf opencode zed copilot)' -d 'comma-separated agent ids, skips the prompt (e.g. claude,cursor)'
complete -c nittle -n '__nittle_scope_is "setup"' -l remove -d 'unwire nittle instead'
complete -c nittle -n '__nittle_scope_is "setup"' -l yes -d 'skip the confirmation prompt'
complete -c nittle -n '__nittle_scope_is "setup"' -s h -l help -d 'show help'
complete -c nittle -n '__nittle_scope_is "lsp"' -s v -l version -d 'print the installed version'
complete -c nittle -n '__nittle_scope_is "lsp"' -l license -d 'print the bundled MIT license notice'
complete -c nittle -n '__nittle_scope_is "lsp"' -s h -l help -d 'show help'
complete -c nittle -n '__nittle_scope_is "lsp set"' -s v -l version -d 'print the installed version'
complete -c nittle -n '__nittle_scope_is "lsp set"' -l license -d 'print the bundled MIT license notice'
complete -c nittle -n '__nittle_scope_is "lsp set"' -s h -l help -d 'show help'
complete -c nittle -n '__nittle_scope_is "lsp unset"' -s v -l version -d 'print the installed version'
complete -c nittle -n '__nittle_scope_is "lsp unset"' -l license -d 'print the bundled MIT license notice'
complete -c nittle -n '__nittle_scope_is "lsp unset"' -s h -l help -d 'show help'
complete -c nittle -n '__nittle_scope_is "completion"' -s v -l version -d 'print the installed version'
complete -c nittle -n '__nittle_scope_is "completion"' -l license -d 'print the bundled MIT license notice'
complete -c nittle -n '__nittle_scope_is "completion"' -l shell -x -a 'bash zsh fish powershell' -d 'shell to generate for: bash, zsh, fish, powershell'
complete -c nittle -n '__nittle_scope_is "completion"' -s h -l help -d 'show help'
complete -c nittle -n '__nittle_needs_sub mcp' -a 'serve list restart'
complete -c nittle -n '__nittle_needs_sub hook' -a 'stop'
complete -c nittle -n '__nittle_needs_sub lsp' -a 'set unset'
complete -c nittle -n '__nittle_wants_review_word' -a 'staged browse'
complete -c nittle -n '__nittle_wants_ref' -a '(__nittle_refs)'
"
`;

exports[`completion scripts powershell output matches the snapshot 1`] = `
"# powershell completion for nittle
# install: nittle completion --shell powershell | Out-String | Invoke-Expression
Register-ArgumentCompleter -Native -CommandName nittle, nittle.exe -ScriptBlock {
  param($wordToComplete, $commandAst, $cursorPosition)
  $commands = @{
    'show' = 'review one commit against its first parent'
    'mcp' = 'run or manage the local MCP server agents talk to'
    'hook' = 'experimental agent stop hook that opens a review of the working tree'
    'sessions' = 'list running review sessions (host, port, age, live/stale)'
    'cleanup' = 'stop stale sessions and finished reviews'
    'update' = 'download and install the latest release'
    'doctor' = 'check for stale agent plugins, old MCP configs, and an unfinished migration'
    'setup' = 'wire nittle into your coding agents (plugin or MCP config)'
    'lsp' = 'show which language server each language gets, and override it'
    'completion' = 'print a tab-completion script for your shell'
  }
  $scopes = @{
    'review' = @('-p', '--port', '--no-open', '--wait', '--json', '--no-lsp', '--lsp', '--review-id', '-v', '--version', '--license', '-h', '--help')
    'show' = @('-p', '--port', '--no-open', '--no-lsp', '--lsp', '-v', '--version', '--license', '-h', '--help')
    'mcp' = @('-h', '--help')
    'mcp serve' = @('-v', '--version', '--license', '-h', '--help')
    'mcp list' = @('-v', '--version', '--license', '-h', '--help')
    'mcp restart' = @('-v', '--version', '--license', '--yes', '-h', '--help')
    'hook' = @('-h', '--help')
    'hook stop' = @('-v', '--version', '--license', '--agent', '-h', '--help')
    'sessions' = @('-v', '--version', '--license', '-h', '--help')
    'cleanup' = @('-v', '--version', '--license', '--yes', '--all', '-h', '--help')
    'update' = @('-v', '--version', '--license', '--check', '-h', '--help')
    'doctor' = @('-v', '--version', '--license', '--yes', '--fix', '-h', '--help')
    'setup' = @('-v', '--version', '--license', '--agents', '--remove', '--yes', '-h', '--help')
    'lsp' = @('-v', '--version', '--license', '-h', '--help')
    'lsp set' = @('-v', '--version', '--license', '-h', '--help')
    'lsp unset' = @('-v', '--version', '--license', '-h', '--help')
    'completion' = @('-v', '--version', '--license', '--shell', '-h', '--help')
  }
  $subcommands = @{
    'mcp' = @('serve', 'list', 'restart')
    'hook' = @('stop')
    'lsp' = @('set', 'unset')
  }
  $tips = @{
    '-p' = 'serve on a fixed port (default: any free port)'
    '--port' = 'serve on a fixed port (default: any free port)'
    '--no-open' = 'don''t open the browser automatically'
    '--wait' = 'block until feedback is returned, then print the prompt on stdout'
    '--json' = 'with --wait, print the review record as JSON instead of the prompt'
    '--no-lsp' = 'start no language servers'
    '--lsp' = 'use this server for one language this run; an empty command disables it (e.g. rust=rust-analyzer)'
    '--review-id' = 'open an existing durable Review Record'
    '-v' = 'print the installed version'
    '--version' = 'print the installed version'
    '--license' = 'print the bundled MIT license notice'
    '-h' = 'show help'
    '--help' = 'show help'
    '--yes' = 'skip the confirmation prompt'
    '--agent' = 'the agent calling the hook: codex or claude-code'
    '--all' = 'also stop active (not just finished/stale) sessions'
    '--check' = 'only report whether a newer release exists'
    '--fix' = 'run the repair commands through the \`claude\` cli'
    '--agents' = 'comma-separated agent ids, skips the prompt (e.g. claude,cursor)'
    '--remove' = 'unwire nittle instead'
    '--shell' = 'shell to generate for: bash, zsh, fish, powershell'
  }
  $choices = @{
    '--agent' = @('codex', 'claude-code')
    '--agents' = @('claude', 'codex', 'cursor', 'gemini', 'vscode', 'windsurf', 'opencode', 'zed', 'copilot')
    '--shell' = @('bash', 'zsh', 'fish', 'powershell')
  }
  $freeValue = @('-p', '--port', '--lsp', '--review-id')
  $refCommands = @('review', 'show')
  $reviewWords = @('staged', 'browse')

  # only the words that end at or before the cursor count (program excluded; the command is the first
  # one, as in the parser). a word ending exactly at the cursor is the one being completed, so it goes too.
  $before = @($commandAst.CommandElements | Where-Object { $_.Extent.EndOffset -le $cursorPosition })
  if ($before.Count -gt 0 -and $before[-1].Extent.EndOffset -eq $cursorPosition) { $before = @($before | Select-Object -SkipLast 1) }
  $typed = @($before | Select-Object -Skip 1 | ForEach-Object { $_.ToString() })
  $cmd = 'review'
  $lead = 0
  if ($typed.Count -gt 0 -and $commands.ContainsKey($typed[0])) { $cmd = $typed[0]; $lead = 1 }
  $scope = $cmd
  if ($subcommands.ContainsKey($cmd) -and $typed.Count -gt 1 -and $subcommands[$cmd] -contains $typed[1]) { $scope = "$cmd $($typed[1])"; $lead = 2 }
  $prev = ''
  if ($typed.Count -gt 0) { $prev = $typed[-1] }

  $positionals = 0
  $skipNext = $false
  for ($i = $lead; $i -lt $typed.Count; $i++) {
    if ($skipNext) { $skipNext = $false; continue }
    if ($freeValue -contains $typed[$i] -or $choices.ContainsKey($typed[$i])) { $skipNext = $true; continue }
    if ($typed[$i] -notlike '-*') { $positionals++ }
  }

  $items = @()
  if ($choices.ContainsKey($prev)) {
    foreach ($value in $choices[$prev]) { $items += [pscustomobject]@{ Text = $value; Insert = $value; Tip = $value } }
  } elseif ($freeValue -contains $prev) {
    return
  } elseif ($wordToComplete -like '-*') {
    if ($scopes.ContainsKey($scope)) {
      foreach ($flag in $scopes[$scope]) { $items += [pscustomobject]@{ Text = $flag; Insert = $flag; Tip = $tips[$flag] } }
    }
  } else {
    if ($typed.Count -eq 0) {
      foreach ($name in $commands.Keys) { $items += [pscustomobject]@{ Text = $name; Insert = $name; Tip = $commands[$name] } }
    }
    if ($typed.Count -eq 1 -and $subcommands.ContainsKey($cmd)) {
      foreach ($sub in $subcommands[$cmd]) { $items += [pscustomobject]@{ Text = $sub; Insert = $sub; Tip = $sub } }
    }
    if ($refCommands -contains $cmd -and $positionals -eq 0) {
      if ($cmd -eq 'review') { foreach ($word in $reviewWords) { $items += [pscustomobject]@{ Text = $word; Insert = $word; Tip = $word } } }
      foreach ($ref in @(& git for-each-ref '--format=%(refname:short)' refs/heads refs/remotes refs/tags 2>$null)) {
        if (-not $ref) { continue }
        $insert = $ref
        if ($ref -notmatch '^[A-Za-z0-9_./+-]+$') { $insert = "'" + $ref.Replace("'", "''") + "'" }
        $items += [pscustomobject]@{ Text = $ref; Insert = $insert; Tip = $ref }
      }
    }
  }
  $prefix = $wordToComplete.TrimStart("'", '"')
  $items | Where-Object { $_.Text.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase) } | Sort-Object Text | ForEach-Object {
    [System.Management.Automation.CompletionResult]::new($_.Insert, $_.Text, 'ParameterValue', $_.Tip)
  }
}
"
`;
