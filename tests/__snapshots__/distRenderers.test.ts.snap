// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`homebrew formula matches the snapshot 1`] = `
"class Nittle < Formula
  desc "Local git diff viewer with inline comments and structured agent feedback"
  homepage "https://nittle.dev"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/codywilliamson/nittle/releases/download/v1.2.3/nittle-darwin-arm64", using: :nounzip
      sha256 "4444444444444444444444444444444444444444444444444444444444444444"
    end
    on_intel do
      url "https://github.com/codywilliamson/nittle/releases/download/v1.2.3/nittle-darwin-x64", using: :nounzip
      sha256 "3333333333333333333333333333333333333333333333333333333333333333"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/codywilliamson/nittle/releases/download/v1.2.3/nittle-linux-arm64", using: :nounzip
      sha256 "2222222222222222222222222222222222222222222222222222222222222222"
    end
    on_intel do
      url "https://github.com/codywilliamson/nittle/releases/download/v1.2.3/nittle-linux-x64", using: :nounzip
      sha256 "1111111111111111111111111111111111111111111111111111111111111111"
    end
  end

  def install
    bin.install Dir["nittle-*"].first => "nittle"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/nittle --version")
  end
end
"
`;

exports[`scoop manifest matches the snapshot 1`] = `
"{
  "version": "1.2.3",
  "description": "Local git diff viewer with inline comments and structured agent feedback",
  "homepage": "https://nittle.dev",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/codywilliamson/nittle/releases/download/v1.2.3/nittle-windows-x64.exe#/nittle.exe",
      "hash": "5555555555555555555555555555555555555555555555555555555555555555"
    },
    "arm64": {
      "url": "https://github.com/codywilliamson/nittle/releases/download/v1.2.3/nittle-windows-arm64.exe#/nittle.exe",
      "hash": "6666666666666666666666666666666666666666666666666666666666666666"
    }
  },
  "bin": "nittle.exe",
  "checkver": {
    "github": "https://github.com/codywilliamson/nittle"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/codywilliamson/nittle/releases/download/v$version/nittle-windows-x64.exe#/nittle.exe",
        "hash": {
          "url": "https://github.com/codywilliamson/nittle/releases/download/v$version/checksums.txt",
          "regex": "$sha256\\\\s+nittle-windows-x64\\\\.exe"
        }
      },
      "arm64": {
        "url": "https://github.com/codywilliamson/nittle/releases/download/v$version/nittle-windows-arm64.exe#/nittle.exe",
        "hash": {
          "url": "https://github.com/codywilliamson/nittle/releases/download/v$version/checksums.txt",
          "regex": "$sha256\\\\s+nittle-windows-arm64\\\\.exe"
        }
      }
    }
  }
}
"
`;

exports[`npm packages renders the main package.json 1`] = `
"{
  "name": "nittle",
  "version": "1.2.3",
  "license": "MIT",
  "homepage": "https://nittle.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codywilliamson/nittle.git"
  },
  "author": "Cody Williamson",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Local git diff viewer with inline comments and structured agent feedback",
  "bin": {
    "nittle": "bin/cli.js"
  },
  "files": [
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "nittle-linux-x64": "1.2.3",
    "nittle-linux-arm64": "1.2.3",
    "nittle-darwin-x64": "1.2.3",
    "nittle-darwin-arm64": "1.2.3",
    "nittle-win32-x64": "1.2.3",
    "nittle-win32-arm64": "1.2.3"
  }
}
"
`;

